# Copy to .env and change before deploying.
JWT_SECRET=replace-this-with-a-long-random-string
PORT=3000

# Used to send "forgot password" reset links to parents.
# Gmail: turn on 2-Step Verification on the account, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it
# below (NOT your normal Gmail password).
# If left blank, reset links are just printed to the server console instead
# of emailed - handy for testing without setting up email at all.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Base URL used to build the reset link, e.g. http://localhost:3000
# Leave blank to auto-detect from the incoming request.
APP_BASE_URL=
